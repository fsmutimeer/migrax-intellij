<idea-plugin>
  <id>org.migrax.ide</id>
  <name>Migrax</name>
  <vendor url="https://migrax.org">Migrax</vendor>

  <description><![CDATA[
    Companion for <a href="https://migrax.org">Migrax</a>, which generates SQL migrations from
    your JPA/Hibernate entities. Adds a Migrax tool window to IntelliJ IDEA with the state of
    the migrations, the SQL of the next migration, lint findings and the configured databases,
    a status bar entry, an icon next to entity classes (Java and Kotlin) whose changes are not
    in a migration yet, lint findings marked inside migration files, and a toolbar and a
    Tools > Migrax menu to generate migrations, migrate, roll back, find drift, verify the
    migrations on a throwaway database, run the doctor and set up Migrax in a new project.
    Needs
    the Migrax command line.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <depends optional="true" config-file="migrax-kotlin.xml">org.jetbrains.kotlin</depends>

  <extensions defaultExtensionNs="com.intellij">
    <applicationConfigurable parentId="tools"
                             id="org.migrax.ide.settings"
                             displayName="Migrax"
                             instance="org.migrax.intellij.MigraxConfigurable"/>
    <postStartupActivity implementation="org.migrax.intellij.MigraxStartupActivity"/>
    <statusBarWidgetFactory id="MigraxStatusBar"
                            implementation="org.migrax.intellij.MigraxStatusBarWidgetFactory"/>
    <codeInsight.lineMarkerProvider
        language="JAVA"
        implementationClass="org.migrax.intellij.MigraxEntityLineMarkerProvider"/>
    <!-- Any language: SQL files are plain text without the Database plugin. -->
    <externalAnnotator
        language=""
        implementationClass="org.migrax.intellij.MigraxSqlLintAnnotator"/>
    <notificationGroup id="Migrax" displayType="BALLOON"/>
    <toolWindow id="Migrax"
                anchor="bottom"
                icon="/icons/migrax.svg"
                factoryClass="org.migrax.intellij.MigraxToolWindowFactory"/>
  </extensions>

  <!-- Without this the Kotlin plugin in K2 mode turns off the Kotlin part. The IDE reads it
       here, from the main file, when the plugin depends on Kotlin. -->
  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
  </extensions>

  <actions>
    <group id="Migrax.Menu" class="org.migrax.intellij.MigraxActions$Menu" text="Migrax"
           popup="true" icon="/icons/migrax.svg">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="Migrax.Init" class="org.migrax.intellij.MigraxActions$Init"
              text="Set Up Migrax..." icon="AllIcons.General.Settings"
              description="Create the Migrax folders and show what Migrax detected"/>
      <action id="Migrax.Generate" class="org.migrax.intellij.MigraxActions$Generate"
              text="Generate Migration" icon="AllIcons.Actions.AddFile"
              description="Write the next migration from the entity changes"/>
      <action id="Migrax.GenerateZeroDowntime"
              class="org.migrax.intellij.MigraxActions$GenerateZeroDowntime"
              text="Generate for Zero Downtime"
              description="Expand now, contract later: old and new version run side by side"/>
      <action id="Migrax.GenerateContract"
              class="org.migrax.intellij.MigraxActions$GenerateContract"
              text="Generate Contract"
              description="Add the waiting contract migration of a zero-downtime change"/>
      <action id="Migrax.New" class="org.migrax.intellij.MigraxActions$NewMigration"
              text="New Migration..." icon="AllIcons.General.Add"
              description="Create an empty migration for hand-written SQL, such as a data change"/>
      <action id="Migrax.Plan" class="org.migrax.intellij.MigraxActions$Plan"
              text="Show Plan" icon="AllIcons.Actions.Preview"
              description="Show the SQL of the next migration"/>
      <separator/>
      <action id="Migrax.Migrate" class="org.migrax.intellij.MigraxActions$Migrate"
              text="Migrate..." icon="AllIcons.Actions.Execute"
              description="Apply the pending migrations to the database"/>
      <action id="Migrax.Rollback" class="org.migrax.intellij.MigraxActions$Rollback"
              text="Roll Back..." icon="AllIcons.Actions.Rollback"
              description="Roll back the newest applied migration in the database"/>
      <action id="Migrax.Repair" class="org.migrax.intellij.MigraxActions$Repair"
              text="Repair..." icon="AllIcons.Toolwindows.ToolWindowBuild"
              description="Fix the history of failed or missing migrations"/>
      <action id="Migrax.Backups" class="org.migrax.intellij.MigraxActions$Backups"
              text="Backups..."
              description="List or drop the backup tables of dropped data"/>
      <separator/>
      <action id="Migrax.Drift" class="org.migrax.intellij.MigraxActions$Drift"
              text="Drift" icon="AllIcons.Actions.Diff"
              description="Find changes made to the database outside the migrations"/>
      <action id="Migrax.Verify" class="org.migrax.intellij.MigraxActions$Verify"
              text="Verify"
              description="Apply every migration to a throwaway database and check the result"/>
      <action id="Migrax.Report" class="org.migrax.intellij.MigraxActions$Report"
              text="Report"
              description="Open an HTML report of the schema, migrations, lint and drift"/>
      <action id="Migrax.Doctor" class="org.migrax.intellij.MigraxActions$Doctor"
              text="Doctor" icon="AllIcons.General.InspectionsOK"
              description="Check the Migrax settings, the project and the database"/>
    </group>
    <!-- The buttons down the left of the Migrax tool window: the menu's actions and Refresh. -->
    <group id="Migrax.ToolWindowToolbar">
      <action id="Migrax.Refresh" class="org.migrax.intellij.MigraxActions$Refresh"
              text="Refresh" icon="AllIcons.Actions.Refresh"
              description="Load the open tab of the Migrax tool window again"/>
      <reference ref="Migrax.Init"/>
      <separator/>
      <reference ref="Migrax.New"/>
      <reference ref="Migrax.Generate"/>
      <reference ref="Migrax.Plan"/>
      <separator/>
      <reference ref="Migrax.Migrate"/>
      <reference ref="Migrax.Rollback"/>
      <reference ref="Migrax.Repair"/>
      <separator/>
      <reference ref="Migrax.Drift"/>
      <reference ref="Migrax.Doctor"/>
      <group id="Migrax.More" text="More" popup="true" icon="AllIcons.Actions.More">
        <reference ref="Migrax.GenerateZeroDowntime"/>
        <reference ref="Migrax.GenerateContract"/>
        <separator/>
        <reference ref="Migrax.Verify"/>
        <reference ref="Migrax.Report"/>
        <separator/>
        <reference ref="Migrax.Backups"/>
      </group>
    </group>
    <!-- The popup of the margin icon next to an entity class with changes. -->
    <group id="Migrax.EntityGutter">
      <reference ref="Migrax.Generate"/>
      <reference ref="Migrax.Plan"/>
    </group>
  </actions>

  <projectListeners>
    <listener class="org.migrax.intellij.MigraxFileChangeListener"
              topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
  </projectListeners>
</idea-plugin>
